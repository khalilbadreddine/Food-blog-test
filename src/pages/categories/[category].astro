---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const categories = Array.from(new Set(recipes.map(r => r.data.category.toLowerCase())));

  return categories.map(category => ({
    params: { category },
    props: {
      categoryName: category,
      recipes: recipes.filter(r => r.data.category.toLowerCase() === category),
    },
  }));
}

const { categoryName, recipes } = Astro.props;
---

<BaseLayout
  title={`Category: ${categoryName.toUpperCase()}`}
  description={`Browse all recipes in the ${categoryName} category.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <a href="/recipes" class="text-xs font-mono text-warm-600 uppercase tracking-wider hover:underline mb-2 block">← Back to All Recipes</a>
      <h1 class="text-4xl font-serif font-bold text-warm-950 capitalize">{categoryName} Blueprints</h1>
      <p class="text-warm-700 font-sans mt-2">Showing {recipes.length} recipe{recipes.length > 1 ? 's' : ''} in this category.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {recipes.map((recipe: any) => (
        <div class="group rounded-2xl overflow-hidden bg-white border border-warm-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
          <a href={`/recipes/${recipe.slug}`} class="block relative aspect-[2/3] overflow-hidden bg-warm-100">
            <img
              src={recipe.data.hero_image}
              alt={recipe.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </a>
          <div class="p-6">
            <h2 class="text-xl font-serif font-bold text-warm-950 mb-2">
              <a href={`/recipes/${recipe.slug}`}>{recipe.data.title}</a>
            </h2>
            <p class="text-sm text-warm-700 line-clamp-2">{recipe.data.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
