---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');
---

<BaseLayout
  title="Home"
  description="Deconstructing recipes into 3D diagrams and assembly models. Engineered food for home cooks."
>
  <section class="relative bg-warm-900 text-warm-50 overflow-hidden py-16 sm:py-24 border-b border-warm-800">
    <div class="absolute inset-0 opacity-10 bg-blueprint-grid"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-2xl">
        <span class="inline-block px-3 py-1 rounded-full bg-blueprint-accent/20 text-blueprint-accent font-mono text-xs uppercase tracking-widest mb-4 border border-blueprint-accent/30">
          Exploded 3D Diagrams & Assembly Models
        </span>
        <h1 class="text-4xl sm:text-6xl font-serif font-bold tracking-tight text-white mb-6 leading-tight">
          Food treated like systems, not just photos.
        </h1>
        <p class="text-lg text-warm-200 font-sans leading-relaxed mb-8">
          Welcome to Engineered Food. We break down dishes into interactive 3D exploded views, structural cross-sections, and precise scaling formulas to help you understand how flavors and structures assemble.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/recipes" class="px-6 py-3 rounded-lg bg-warm-50 text-warm-950 font-medium font-mono text-sm hover:bg-warm-200 transition-colors shadow-md">
            Browse Interactive Models →
          </a>
          <a href="/blog/deconstructing-flavor" class="px-6 py-3 rounded-lg bg-warm-800/80 text-warm-100 font-medium font-mono text-sm hover:bg-warm-800 transition-colors border border-warm-700">
            Read The Manifesto
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-serif font-bold text-warm-950">Featured & Recent Diagrams</h2>
        <p class="text-xs font-mono text-warm-600 mt-1 uppercase tracking-wider">Vertical Pins & Interactive Blueprints</p>
      </div>
      <a href="/recipes" class="text-sm font-mono text-warm-800 hover:text-warm-950 underline">View all ({recipes.length})</a>
    </div>

    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      {recipes.map(recipe => (
        <div class="break-inside-avoid group relative rounded-2xl overflow-hidden bg-white border border-warm-200 shadow-sm hover:shadow-xl transition-all duration-300">
          <a href={`/recipes/${recipe.slug}`} class="block">
            <div class="relative aspect-[2/3] overflow-hidden bg-warm-100">
              <img
                src={recipe.data.hero_image}
                alt={recipe.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              {recipe.data.model_interaction_type !== 'none' && (
                <div class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-blueprint-bg/90 text-blueprint-accent text-xs font-mono font-bold border border-blueprint-accent/40 shadow-lg backdrop-blur-sm flex items-center space-x-1.5">
                  <span class="w-2 h-2 rounded-full bg-blueprint-glow animate-pulse"></span>
                  <span class="uppercase">{recipe.data.model_interaction_type} 3D</span>
                </div>
              )}
            </div>

            <div class="p-5">
              <div class="flex items-center space-x-2 text-xs font-mono text-warm-600 uppercase tracking-wider mb-2">
                <span>{recipe.data.category}</span>
                <span>•</span>
                <span>{recipe.data.total_time.replace('PT', '').toLowerCase()}</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-warm-950 group-hover:text-warm-700 transition-colors mb-2">
                {recipe.data.title}
              </h3>
              <p class="text-sm text-warm-700 font-sans line-clamp-2">
                {recipe.data.description}
              </p>
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
