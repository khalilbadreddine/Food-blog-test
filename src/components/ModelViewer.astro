---
interface Props {
  src: string;
  alt: string;
  poster?: string;
  ar?: boolean;
}

const { src, alt, poster, ar = true } = Astro.props;
---

<div class="relative w-full aspect-square max-w-2xl mx-auto rounded-2xl overflow-hidden bg-blueprint-bg border border-blueprint-accent/40 shadow-xl">
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.4.0/model-viewer.min.js"></script>

  <model-viewer
    src={src}
    alt={alt}
    poster={poster}
    {...(ar ? { ar: true, 'ar-modes': 'webxr scene-viewer quicklook' } : {})}
    camera-controls
    touch-action="pan-y"
    shadow-intensity="1"
    shadow-softness="0.8"
    exposure="1.0"
    auto-rotate
    class="w-full h-full"
    style="background-color: #0a192f;"
  >
    <div slot="poster" class="w-full h-full flex items-center justify-center bg-blueprint-bg text-blueprint-text font-mono text-sm">
      Loading 3D Diagram...
    </div>

    <button slot="ar-button" class="absolute bottom-4 right-4 bg-blueprint-accent text-blueprint-bg font-mono font-bold text-xs px-4 py-2 rounded-lg shadow-lg hover:bg-white transition-colors">
      View in your Kitchen (AR) 📱
    </button>
  </model-viewer>

  <div class="absolute top-3 left-3 px-3 py-1 bg-blueprint-bg/80 border border-blueprint-accent/30 rounded text-blueprint-accent font-mono text-xs backdrop-blur-sm pointer-events-none">
    3D Model • Drag to Rotate
  </div>
</div>
