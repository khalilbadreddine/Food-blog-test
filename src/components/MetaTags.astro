---
interface Props {
  title: string;
  description: string;
  image?: string;
  articleType?: 'article' | 'website';
  publishedTime?: string;
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  articleType = 'website',
  publishedTime
} = Astro.props;

const siteName = "Engineered Food";
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://engineeredfood.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
---

<link rel="canonical" href={canonicalUrl} />
<title>{title} | {siteName}</title>
<meta name="title" content={`${title} | ${siteName}`} />
<meta name="description" content={description} />

<meta property="og:type" content={articleType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1000" />
<meta property="og:image:height" content="1500" />
<meta property="og:site_name" content={siteName} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
