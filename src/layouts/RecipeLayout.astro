---
import BaseLayout from './BaseLayout.astro';
import RecipeJsonLd from '../components/RecipeJsonLd.astro';

interface Props {
  recipe: any;
}

const { recipe } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://engineeredfood.com';
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<BaseLayout
  title={recipe.title}
  description={recipe.description}
  image={recipe.hero_image}
  publishedTime={recipe.published_date}
>
  <RecipeJsonLd recipe={recipe} canonicalUrl={currentUrl} />

  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="max-w-3xl mb-8">
      <div class="flex items-center space-x-3 mb-4">
        <a href={`/categories/${recipe.category.toLowerCase()}`} class="inline-block px-3 py-1 rounded-full bg-warm-200 text-warm-800 text-xs font-mono font-semibold uppercase tracking-wider hover:bg-warm-300 transition-colors">
          {recipe.category}
        </a>
        {recipe.diet && recipe.diet.map((d: string) => (
          <span class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-mono font-medium">
            {d}
          </span>
        ))}
      </div>

      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-warm-950 tracking-tight leading-tight mb-4">
        {recipe.title}
      </h1>

      <p class="text-lg text-warm-700 leading-relaxed font-sans mb-6">
        {recipe.description}
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-4 px-6 bg-warm-100/70 rounded-xl border border-warm-200/80 text-sm font-mono">
        <div>
          <span class="block text-xs uppercase tracking-wider text-warm-600">Prep Time</span>
          <span class="font-bold text-warm-900">{recipe.prep_time.replace('PT', '').toLowerCase()}</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-warm-600">Cook Time</span>
          <span class="font-bold text-warm-900">{recipe.cook_time.replace('PT', '').toLowerCase()}</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-warm-600">Total Time</span>
          <span class="font-bold text-warm-900">{recipe.total_time.replace('PT', '').toLowerCase()}</span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wider text-warm-600">Servings</span>
          <span class="font-bold text-warm-900">{recipe.servings}</span>
        </div>
      </div>
    </div>

    <div class="mb-12">
      <slot name="interactive-viewer">
        <div class="relative aspect-[2/3] max-w-xl mx-auto rounded-2xl overflow-hidden shadow-xl border border-warm-200">
          <img
            src={recipe.hero_image}
            alt={recipe.title}
            class="w-full h-full object-cover"
          />
        </div>
      </slot>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <aside class="lg:col-span-4 bg-warm-100/50 p-6 rounded-2xl border border-warm-200/80 h-fit">
        <h2 class="text-xl font-serif font-bold text-warm-950 mb-4 pb-2 border-b border-warm-300/60 flex items-center justify-between">
          <span>Ingredients</span>
          <span class="text-xs font-mono font-normal text-warm-600">Yield: {recipe.servings}</span>
        </h2>

        <ul class="space-y-3 font-sans text-sm text-warm-900">
          {recipe.ingredients.map((ing: any) => (
            <li class="flex items-start justify-between py-1.5 border-b border-warm-200/50 last:border-0">
              <span class="font-medium text-warm-950">{ing.name} {ing.notes && <span class="text-warm-600 font-normal text-xs">({ing.notes})</span>}</span>
              <span class="font-mono text-warm-700 whitespace-nowrap ml-4">{ing.amount} {ing.unit}</span>
            </li>
          ))}
        </ul>

        {recipe.nutrition && (
          <div class="mt-8 pt-4 border-t border-warm-300/60">
            <h3 class="text-xs font-mono uppercase tracking-wider text-warm-600 mb-3">Nutrition per serving</h3>
            <div class="grid grid-cols-2 gap-2 text-xs font-mono text-warm-800">
              {recipe.nutrition.calories && <div>Calories: <span class="font-bold">{recipe.nutrition.calories}</span></div>}
              {recipe.nutrition.protein && <div>Protein: <span class="font-bold">{recipe.nutrition.protein}</span></div>}
              {recipe.nutrition.carbohydrates && <div>Carbs: <span class="font-bold">{recipe.nutrition.carbohydrates}</span></div>}
              {recipe.nutrition.fat && <div>Fat: <span class="font-bold">{recipe.nutrition.fat}</span></div>}
            </div>
          </div>
        )}
      </aside>

      <section class="lg:col-span-8">
        <h2 class="text-2xl font-serif font-bold text-warm-950 mb-6 pb-2 border-b border-warm-200">
          Assembly & Instructions
        </h2>

        <div class="space-y-8">
          {recipe.instructions.map((inst: any) => (
            <div class="flex items-start space-x-4 group">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-warm-900 text-warm-50 font-mono font-bold flex items-center justify-center text-sm shadow-sm">
                {inst.step}
              </div>
              <div class="flex-grow pt-0.5">
                {inst.name && (
                  <h3 class="text-base font-bold text-warm-950 font-sans mb-1">
                    {inst.name}
                  </h3>
                )}
                <p class="text-warm-800 leading-relaxed font-sans">
                  {inst.text}
                </p>
                {inst.image && (
                  <img src={inst.image} alt={`Step ${inst.step}`} class="mt-3 rounded-lg border border-warm-200 max-h-64 object-cover" />
                )}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 pt-8 border-t border-warm-200 prose prose-warm max-w-none">
          <slot />
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
